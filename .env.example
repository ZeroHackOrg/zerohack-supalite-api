# zh-api — SupaLite-compatible API configuration (all optional)

# Port / bind
PORT=3001
ZH_API_HOST=127.0.0.1

# Database — sqlite file, :memory:, or a postgres:// URL.
#   ZH_API_DATABASE=supalite.db
#   ZH_API_DATABASE=:memory:
#   ZH_API_DATABASE=postgres://user:pass@localhost:5432/supalite
ZH_API_DATABASE=

# Seed N sample CVEs on boot (0 disables)
ZH_API_SEED=24

# Auth — leave both empty for dev mode (open access).
# Set a shared secret to enforce Bearer <jwt> (HS256) with a `role` claim,
# and an anon key to require the `apikey` header supabase-js always sends.
ZH_API_JWT_SECRET=
ZH_API_ANON_KEY=
ZH_API_DEFAULT_ROLE=anon